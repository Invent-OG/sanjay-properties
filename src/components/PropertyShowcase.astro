---
import { propertyShowcaseData, siteConfig } from '../data/sanjayGarden';
---

<section id="property-showcase" class="py-12 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 max-w-7xl mx-auto relative overflow-hidden">
  
  <!-- Massive Background Watermark Number -->
  <div class="absolute -right-4 sm:right-4 top-6 sm:top-10 text-[100px] sm:text-[200px] lg:text-[280px] font-black text-black/[0.03] leading-none pointer-events-none watermark-text select-none overflow-hidden">
    01
  </div>

  <!-- Header -->
  <div class="max-w-3xl mb-8 sm:mb-12 gsap-fade-up relative z-10">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-black/5 text-[11px] sm:text-xs font-semibold tracking-widest uppercase text-[#121417] mb-3">
      <span class="w-1.5 h-1.5 rounded-full bg-[#cbf33e]"></span>
      PROPERTY SHOWCASE
    </div>
    <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-[#121417] leading-[1.18] sm:leading-[1.15]">
      Find Your Place
    </h2>
    <p class="text-sm sm:text-base md:text-lg text-[#5c626c] mt-2 sm:mt-3 max-w-xl">
      Explore residential house-site opportunities at Sanjay Garden in Saravanampatti, Coimbatore.
    </p>
  </div>

  <!-- Data-Driven Property Cards Container -->
  <div class="relative z-10 bg-white rounded-[1.75rem] sm:rounded-[2.5rem] p-5 sm:p-8 lg:p-10 border border-black/5 shadow-sm space-y-6 sm:space-y-8">
    
    <!-- Top Info Strip -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-5 border-b border-black/5">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-[#0e1013]"></span>
        <h3 class="text-sm sm:text-base font-bold text-[#121417] uppercase tracking-wider">
          Residential House Site Framework
        </h3>
      </div>
      <span class="text-xs text-[#5c626c]">
        Historical Layout Reference: <strong class="text-[#121417]">{siteConfig.layoutApprovalRef}</strong>
      </span>
    </div>

    <!-- Plots Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">
      {propertyShowcaseData.map((plot, idx) => (
        <div class="rounded-2xl p-5 sm:p-6 bg-neutral-50/80 border border-black/5 flex flex-col justify-between hover:border-black/15 transition-all">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-bold text-[#121417] uppercase tracking-wider px-2.5 py-1 rounded-full bg-white border border-black/5">
                {plot.plotNumber}
              </span>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800 text-[11px] font-semibold">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>
                {plot.availability}
              </span>
            </div>

            <div class="space-y-2.5 text-xs text-[#5c626c] my-4">
              <div class="flex justify-between py-1 border-b border-black/5">
                <span>Property Category</span>
                <strong class="text-[#121417] font-semibold">{plot.status}</strong>
              </div>
              <div class="flex justify-between py-1 border-b border-black/5">
                <span>Plot Dimensions</span>
                <span class="text-[#121417] font-medium">{plot.dimensions || "On Request"}</span>
              </div>
              <div class="flex justify-between py-1 border-b border-black/5">
                <span>Facing Direction</span>
                <span class="text-[#121417] font-medium">{plot.facing || "Flexible"}</span>
              </div>
              <div class="flex justify-between py-1">
                <span>Pricing</span>
                <span class="text-xs font-semibold text-[#0e1013]">On Enquiry</span>
              </div>
            </div>
          </div>

          <div class="mt-4 pt-4 border-t border-black/5">
            <a 
              href="#contact" 
              class="w-full py-2.5 px-4 rounded-full bg-[#0e1013] text-white hover:bg-[#cbf33e] hover:text-[#0e1013] text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors text-center"
            >
              <span>Enquire for Details</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Transparent Inventory Notice & Big CTA -->
    <div class="mt-8 p-6 rounded-2xl bg-neutral-100/90 border border-black/5 flex flex-col md:flex-row items-center justify-between gap-5">
      <div class="max-w-xl text-center md:text-left">
        <h4 class="text-base sm:text-lg font-bold text-[#121417]">
          Current availability and pricing available on enquiry.
        </h4>
        <p class="text-xs sm:text-sm text-[#5c626c] mt-1">
          To ensure verified accuracy and real-time status, specific plot numbers and pricing are furnished directly by Sanjay Properties upon request.
        </p>
      </div>

      <a 
        href="#contact" 
        class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-[#cbf33e] text-[#0e1013] font-bold text-xs sm:text-sm hover:bg-[#bce628] transition-all whitespace-nowrap shadow-md text-center"
      >
        <span>ENQUIRE ABOUT AVAILABILITY</span>
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

  </div>

</section>
