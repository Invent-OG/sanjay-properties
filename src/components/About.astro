---
import { siteConfig } from '../data/sanjayGarden';
---

<section id="about" class="py-12 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 max-w-7xl mx-auto">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10 lg:gap-14 items-center">
    
    <!-- Left Column: Architectural Visual Card -->
    <div class="lg:col-span-5 gsap-fade-up">
      <div class="relative rounded-[1.75rem] sm:rounded-[2rem] overflow-hidden shadow-xl aspect-[4/3] sm:aspect-[5/4] lg:aspect-[4/3] bg-neutral-200 image-zoom-container">
        <img 
          src="/images/about.jpg" 
          alt="Sanjay Properties architectural residential planning in Saravanampatti Coimbatore" 
          class="w-full h-full object-cover object-center"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
        <div class="absolute bottom-4 sm:bottom-5 left-4 sm:left-5 right-4 sm:right-5 text-white">
          <p class="text-[11px] sm:text-xs font-semibold tracking-widest uppercase text-[#cbf33e]">Vision & Planning</p>
          <p class="text-xs sm:text-sm font-medium mt-0.5">Saravanampatti Residential Address</p>
        </div>
      </div>
    </div>

    <!-- Right Column: Editorial Text & Statement -->
    <div class="lg:col-span-7 flex flex-col justify-center gsap-fade-up">
      <!-- Section Tag -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-black/5 text-[11px] sm:text-xs font-semibold tracking-widest uppercase text-[#121417] w-fit mb-4 sm:mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-[#0e1013]"></span>
        ABOUT SANJAY PROPERTIES
      </div>

      <!-- Large Statement -->
      <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-[#121417] leading-[1.18] sm:leading-[1.15] mb-4 sm:mb-6">
        “Property is more than land.<br />
        It is where the next chapter begins.”
      </h2>

      <!-- Supporting Body Paragraph -->
      <p class="text-sm sm:text-base md:text-lg text-[#5c626c] font-normal leading-relaxed mb-6 sm:mb-8 max-w-2xl">
        Sanjay Properties is associated with Sanjay Garden in Saravanampatti, Coimbatore, creating a property-focused presence around a thoughtfully planned residential address.
      </p>

      <!-- Editorial Emblem & Location with Official Logo -->
      <div class="flex items-center justify-between pt-5 sm:pt-6 border-t border-black/10">
        <div class="flex items-center gap-3.5">
          <!-- Official Logo Mark -->
          <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-[#0e1013] text-[#cbf33e] flex items-center justify-center p-2 shrink-0 shadow-md">
            <svg class="w-full h-full" viewBox="0 0 160 120" fill="currentColor">
              <path d="M42 20 L86 28 L86 36 L44 28 Z" />
              <path d="M42 42 L86 50 L108 36 L126 42 L126 50 L108 44 L86 58 L42 50 Z" />
              <path d="M42 64 L86 72 L108 58 L126 64 L126 72 L108 66 L86 80 L42 72 Z" />
              <path d="M42 86 L86 94 L108 80 L126 86 L126 94 L108 88 L86 102 L42 94 Z" />
              <rect x="108" y="98" width="18" height="6" rx="1" />
            </svg>
          </div>
          <div>
            <p class="text-xs font-extrabold uppercase tracking-wider text-[#121417]">{siteConfig.brandName}</p>
            <p class="text-[11px] sm:text-xs text-[#5c626c]">Saravanampatti, Coimbatore, Tamil Nadu</p>
          </div>
        </div>

        <!-- Architectural Emblem Badge -->
        <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full border border-black/10 flex items-center justify-center text-[#121417] shrink-0">
          <svg class="w-5 h-5 sm:w-6 sm:h-6" viewBox="0 0 160 120" fill="currentColor">
            <path d="M42 20 L86 28 L86 36 L44 28 Z" />
            <path d="M42 42 L86 50 L108 36 L126 42 L126 50 L108 44 L86 58 L42 50 Z" />
            <path d="M42 64 L86 72 L108 58 L126 64 L126 72 L108 66 L86 80 L42 72 Z" />
            <path d="M42 86 L86 94 L108 80 L126 86 L126 94 L108 88 L86 102 L42 94 Z" />
            <rect x="108" y="98" width="18" height="6" rx="1" />
          </svg>
        </div>
      </div>

    </div>

  </div>
</section>
