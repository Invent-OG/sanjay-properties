---
import { siteConfig } from '../data/sanjayGarden';
---

<!-- Floating Main Navigation Bar -->
<header id="floating-navbar" class="fixed top-0 left-0 right-0 z-40 px-3 sm:px-6 lg:px-10 pt-3 sm:pt-6 pointer-events-none transition-all duration-300">
  <div 
    id="floating-navbar-inner" 
    class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-7 py-2.5 sm:py-3 rounded-full pointer-events-auto bg-white/85 backdrop-blur-md border border-black/5 shadow-sm transition-all duration-300 [&.scrolled-nav]:bg-[#0e1013]/95 [&.scrolled-nav]:text-white [&.scrolled-nav]:border-white/10 [&.scrolled-nav]:shadow-lg"
  >
    <!-- Brand Logo Lockup -->
    <a href="#hero" class="flex items-center gap-2.5 sm:gap-3 group focus:outline-none min-w-0" aria-label="Sanjay Properties Home">
      <!-- Architectural Logo Mark -->
      <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-[#0e1013] text-white flex items-center justify-center p-1.5 transition-transform duration-300 group-hover:scale-105 group-hover:bg-[#E6AF47] group-hover:text-[#0e1013] shrink-0">
        <svg class="w-full h-full" viewBox="0 0 160 120" fill="currentColor">
          <path d="M42 20 L86 28 L86 36 L44 28 Z" />
          <path d="M42 42 L86 50 L108 36 L126 42 L126 50 L108 44 L86 58 L42 50 Z" />
          <path d="M42 64 L86 72 L108 58 L126 64 L126 72 L108 66 L86 80 L42 72 Z" />
          <path d="M42 86 L86 94 L108 80 L126 86 L126 94 L108 88 L86 102 L42 94 Z" />
          <rect x="108" y="98" width="18" height="6" rx="1" />
        </svg>
      </div>
      
      <!-- Wordmark Typography -->
      <div class="flex flex-col">
        <span class="font-extrabold tracking-[0.18em] text-xs sm:text-sm lg:text-base uppercase leading-none text-current">
          SANJAY
        </span>
        <span class="font-bold tracking-[0.25em] text-[8px] sm:text-[9px] uppercase leading-tight opacity-75 mt-0.5">
          PROPERTIES
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2 text-xs lg:text-sm font-medium" aria-label="Main Navigation">
      <a href="#hero" class="px-2.5 lg:px-3 py-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors">Home</a>
      <a href="#sanjay-garden" class="px-2.5 lg:px-3 py-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors">Sanjay Garden</a>
      <a href="#about" class="px-2.5 lg:px-3 py-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors">About</a>
      <a href="#layout" class="px-2.5 lg:px-3 py-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors">Layout</a>
      <a href="#location" class="px-2.5 lg:px-3 py-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors">Location</a>
      <a href="#gallery" class="px-2.5 lg:px-3 py-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors">Gallery</a>
      <a href="#faq" class="px-2.5 lg:px-3 py-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors">FAQ</a>
      <a href="#contact" class="px-2.5 lg:px-3 py-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors">Contact</a>
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <a 
        href="#contact" 
        class="hidden sm:inline-flex items-center justify-center px-4 py-2 text-xs font-semibold rounded-full bg-[#0e1013] text-white hover:bg-[#E6AF47] hover:text-[#0e1013] transition-all duration-300 shadow-sm whitespace-nowrap"
      >
        ENQUIRE NOW
      </a>

      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-btn" 
        type="button" 
        class="md:hidden w-10 h-10 flex items-center justify-center rounded-full hover:bg-black/5 transition-colors focus:outline-none cursor-pointer"
        aria-label="Open Navigation Menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Fullscreen Overlay Menu -->
<div 
  id="mobile-menu-overlay" 
  class="fixed inset-0 z-[100] w-screen h-[100dvh] bg-[#0e1013] text-white flex flex-col justify-between p-6 sm:p-8 opacity-0 pointer-events-none transition-all duration-300 md:hidden overflow-y-auto"
>
  <!-- Mobile Menu Top Header -->
  <div class="flex items-center justify-between pb-4 border-b border-white/10">
    <div class="flex items-center gap-2.5">
      <div class="w-9 h-9 rounded-xl bg-[#E6AF47] text-[#0e1013] flex items-center justify-center p-1.5">
        <svg class="w-full h-full" viewBox="0 0 160 120" fill="currentColor">
          <path d="M42 20 L86 28 L86 36 L44 28 Z" />
          <path d="M42 42 L86 50 L108 36 L126 42 L126 50 L108 44 L86 58 L42 50 Z" />
          <path d="M42 64 L86 72 L108 58 L126 64 L126 72 L108 66 L86 80 L42 72 Z" />
          <path d="M42 86 L86 94 L108 80 L126 86 L126 94 L108 88 L86 102 L42 94 Z" />
          <rect x="108" y="98" width="18" height="6" rx="1" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-extrabold tracking-[0.18em] text-sm uppercase leading-none text-white">SANJAY</span>
        <span class="font-bold tracking-[0.25em] text-[8px] uppercase leading-tight text-white/75 mt-0.5">PROPERTIES</span>
      </div>
    </div>
    <button 
      id="mobile-menu-close" 
      type="button" 
      class="w-10 h-10 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 text-white cursor-pointer transition-colors" 
      aria-label="Close Navigation"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu Links -->
  <nav class="flex flex-col gap-4 text-2xl font-light tracking-tight my-auto py-6" aria-label="Mobile Navigation">
    <a href="#hero" class="mobile-nav-link hover:text-[#E6AF47] transition-colors py-1 flex items-center justify-between">
      <span>Home</span>
      <span class="text-xs text-white/40 font-mono">01</span>
    </a>
    <a href="#sanjay-garden" class="mobile-nav-link hover:text-[#E6AF47] transition-colors py-1 flex items-center justify-between">
      <span>Sanjay Garden</span>
      <span class="text-xs text-white/40 font-mono">02</span>
    </a>
    <a href="#about" class="mobile-nav-link hover:text-[#E6AF47] transition-colors py-1 flex items-center justify-between">
      <span>About Sanjay Properties</span>
      <span class="text-xs text-white/40 font-mono">03</span>
    </a>
    <a href="#layout" class="mobile-nav-link hover:text-[#E6AF47] transition-colors py-1 flex items-center justify-between">
      <span>Layout Viewer</span>
      <span class="text-xs text-white/40 font-mono">04</span>
    </a>
    <a href="#location" class="mobile-nav-link hover:text-[#E6AF47] transition-colors py-1 flex items-center justify-between">
      <span>Location & Connectivity</span>
      <span class="text-xs text-white/40 font-mono">05</span>
    </a>
    <a href="#gallery" class="mobile-nav-link hover:text-[#E6AF47] transition-colors py-1 flex items-center justify-between">
      <span>Architectural Gallery</span>
      <span class="text-xs text-white/40 font-mono">06</span>
    </a>
    <a href="#faq" class="mobile-nav-link hover:text-[#E6AF47] transition-colors py-1 flex items-center justify-between">
      <span>FAQ</span>
      <span class="text-xs text-white/40 font-mono">07</span>
    </a>
    <a href="#contact" class="mobile-nav-link hover:text-[#E6AF47] transition-colors py-1 flex items-center justify-between">
      <span>Contact & Enquiry</span>
      <span class="text-xs text-white/40 font-mono">08</span>
    </a>
  </nav>

  <!-- Mobile Menu Footer Actions -->
  <div class="flex flex-col gap-3 pt-4 border-t border-white/10">
    <a 
      href={`https://wa.me/${siteConfig.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(siteConfig.whatsappDefaultMsg)}`} 
      target="_blank" 
      rel="noopener noreferrer"
      class="w-full text-center py-4 rounded-full bg-[#E6AF47] text-[#0e1013] font-bold text-sm tracking-wide shadow-lg flex items-center justify-center gap-2"
    >
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
      </svg>
      <span>WhatsApp Sanjay Properties</span>
    </a>
    <p class="text-xs text-white/50 text-center">{siteConfig.officeLocation}</p>
  </div>
</div>

<script>
  function setupNavbar() {
    const btn = document.getElementById('mobile-menu-btn');
    const close = document.getElementById('mobile-menu-close');
    const overlay = document.getElementById('mobile-menu-overlay');
    const links = document.querySelectorAll('.mobile-nav-link');

    function toggleMenu(open: boolean) {
      if (!overlay || !btn) return;
      if (open) {
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.classList.add('opacity-100', 'pointer-events-auto');
        btn.setAttribute('aria-expanded', 'true');
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
      } else {
        overlay.classList.add('opacity-0', 'pointer-events-none');
        overlay.classList.remove('opacity-100', 'pointer-events-auto');
        btn.setAttribute('aria-expanded', 'false');
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
      }
    }

    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu(true);
    });

    close?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu(false);
    });

    links.forEach((l) => {
      l.addEventListener('click', () => {
        toggleMenu(false);
      });
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay && !overlay.classList.contains('opacity-0')) {
        toggleMenu(false);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNavbar);
  } else {
    setupNavbar();
  }

  document.addEventListener('astro:page-load', setupNavbar);
</script>
