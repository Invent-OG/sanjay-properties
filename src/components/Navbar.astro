---
import { siteConfig } from '../data/sanjay-gardens';
---

<!-- Floating Main Navigation Bar -->
<header id="floating-navbar" class="fixed top-0 left-0 right-0 z-40 px-3 sm:px-6 lg:px-10 pt-3 sm:pt-6 pointer-events-none transition-all duration-300">
  <div 
    id="floating-navbar-inner" 
    class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-7 py-2.5 sm:py-3 rounded-full pointer-events-auto bg-white/85 backdrop-blur-md border border-black/5 shadow-sm transition-all duration-300 [&.scrolled-nav]:bg-[#0e1013]/95 [&.scrolled-nav]:text-white [&.scrolled-nav]:border-white/10 [&.scrolled-nav]:shadow-lg"
  >
    <!-- Brand -->
    <a href="#hero" class="flex items-center gap-2 sm:gap-2.5 group focus:outline-none min-w-0" aria-label="Sanjay Properties Home">
      <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#0e1013] text-white flex items-center justify-center font-bold text-xs tracking-wider transition-transform duration-300 group-hover:scale-105 group-hover:bg-[#cbf33e] group-hover:text-black shrink-0">
        SP
      </div>
      <span class="font-bold tracking-tight text-xs sm:text-sm lg:text-base uppercase group-hover:opacity-80 transition-opacity truncate">
        {siteConfig.brandName}
      </span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2 text-xs lg:text-sm font-medium" aria-label="Main Navigation">
      <a href="#hero" class="px-2.5 lg:px-3 py-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors">Home</a>
      <a href="#sanjay-gardens" class="px-2.5 lg:px-3 py-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors">Sanjay Gardens</a>
      <a href="#about" class="px-2.5 lg:px-3 py-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors">About</a>
      <a href="#location" class="px-2.5 lg:px-3 py-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors">Location</a>
      <a href="#gallery" class="px-2.5 lg:px-3 py-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors">Gallery</a>
      <a href="#faq" class="px-2.5 lg:px-3 py-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors">FAQ</a>
      <a href="#contact" class="px-2.5 lg:px-3 py-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors">Contact</a>
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <a 
        href={`https://wa.me/${siteConfig.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(siteConfig.whatsappDefaultMsg)}`} 
        target="_blank" 
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center justify-center px-4 py-2 text-xs font-semibold rounded-full bg-[#0e1013] text-white hover:bg-[#cbf33e] hover:text-[#0e1013] transition-all duration-300 shadow-sm whitespace-nowrap"
      >
        Enquire Now
      </a>

      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-btn" 
        type="button" 
        class="md:hidden w-10 h-10 flex items-center justify-center rounded-full hover:bg-black/5 transition-colors focus:outline-none cursor-pointer"
        aria-label="Open Navigation Menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Fullscreen Overlay Menu (Rendered at Root Level outside transformed header) -->
<div 
  id="mobile-menu-overlay" 
  class="fixed inset-0 z-[100] w-screen h-[100dvh] bg-[#0e1013] text-white flex flex-col justify-between p-6 sm:p-8 opacity-0 pointer-events-none transition-all duration-300 md:hidden overflow-y-auto"
>
  <!-- Mobile Menu Top Header -->
  <div class="flex items-center justify-between pb-4 border-b border-white/10">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-full bg-[#cbf33e] text-[#0e1013] flex items-center justify-center font-bold text-xs">
        SP
      </div>
      <span class="font-bold tracking-tight text-base sm:text-lg uppercase text-white">{siteConfig.brandName}</span>
    </div>
    <button 
      id="mobile-menu-close" 
      type="button"
      class="w-10 h-10 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 text-white cursor-pointer transition-colors" 
      aria-label="Close Navigation"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu Links -->
  <nav class="flex flex-col gap-5 text-2xl font-light tracking-tight my-auto py-6" aria-label="Mobile Navigation">
    <a href="#hero" class="mobile-nav-link hover:text-[#cbf33e] transition-colors py-1 flex items-center justify-between">
      <span>Home</span>
      <span class="text-xs text-white/40 font-mono">01</span>
    </a>
    <a href="#sanjay-gardens" class="mobile-nav-link hover:text-[#cbf33e] transition-colors py-1 flex items-center justify-between">
      <span>Sanjay Gardens</span>
      <span class="text-xs text-white/40 font-mono">02</span>
    </a>
    <a href="#about" class="mobile-nav-link hover:text-[#cbf33e] transition-colors py-1 flex items-center justify-between">
      <span>About Us</span>
      <span class="text-xs text-white/40 font-mono">03</span>
    </a>
    <a href="#location" class="mobile-nav-link hover:text-[#cbf33e] transition-colors py-1 flex items-center justify-between">
      <span>Location & Connectivity</span>
      <span class="text-xs text-white/40 font-mono">04</span>
    </a>
    <a href="#gallery" class="mobile-nav-link hover:text-[#cbf33e] transition-colors py-1 flex items-center justify-between">
      <span>Architectural Gallery</span>
      <span class="text-xs text-white/40 font-mono">05</span>
    </a>
    <a href="#faq" class="mobile-nav-link hover:text-[#cbf33e] transition-colors py-1 flex items-center justify-between">
      <span>FAQ</span>
      <span class="text-xs text-white/40 font-mono">06</span>
    </a>
    <a href="#contact" class="mobile-nav-link hover:text-[#cbf33e] transition-colors py-1 flex items-center justify-between">
      <span>Contact & Enquiry</span>
      <span class="text-xs text-white/40 font-mono">07</span>
    </a>
  </nav>

  <!-- Mobile Menu Footer Actions -->
  <div class="flex flex-col gap-3 pt-4 border-t border-white/10">
    <a 
      href={`https://wa.me/${siteConfig.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(siteConfig.whatsappDefaultMsg)}`} 
      target="_blank" 
      rel="noopener noreferrer"
      class="w-full text-center py-4 rounded-full bg-[#cbf33e] text-[#0e1013] font-bold text-sm tracking-wide shadow-lg"
    >
      Chat on WhatsApp
    </a>
    <p class="text-xs text-white/50 text-center">{siteConfig.officeLocation}</p>
  </div>
</div>

<script>
  function setupNavbar() {
    const btn = document.getElementById('mobile-menu-btn');
    const close = document.getElementById('mobile-menu-close');
    const overlay = document.getElementById('mobile-menu-overlay');
    const links = document.querySelectorAll('.mobile-nav-link');

    function toggleMenu(open: boolean) {
      if (!overlay || !btn) return;
      if (open) {
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.classList.add('opacity-100', 'pointer-events-auto');
        btn.setAttribute('aria-expanded', 'true');
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
      } else {
        overlay.classList.add('opacity-0', 'pointer-events-none');
        overlay.classList.remove('opacity-100', 'pointer-events-auto');
        btn.setAttribute('aria-expanded', 'false');
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
      }
    }

    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu(true);
    });

    close?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu(false);
    });

    links.forEach((l) => {
      l.addEventListener('click', () => {
        toggleMenu(false);
      });
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay && !overlay.classList.contains('opacity-0')) {
        toggleMenu(false);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNavbar);
  } else {
    setupNavbar();
  }

  document.addEventListener('astro:page-load', setupNavbar);
</script>
