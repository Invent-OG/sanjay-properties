---
import { faqData, siteConfig } from '../data/sanjayGarden';
---

<section id="faq" class="py-12 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 max-w-7xl mx-auto">
  
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10 lg:gap-14 items-start">
    
    <!-- Left Column: FAQ Architectural Visual Card -->
    <div class="lg:col-span-5 gsap-fade-up">
      <div class="relative rounded-[1.75rem] sm:rounded-[2.5rem] overflow-hidden shadow-xl aspect-[4/3] sm:aspect-[1/1] lg:aspect-[4/5] bg-[#0e1013] image-zoom-container">
        <img 
          src="/images/faq.jpg" 
          alt="Sanjay Garden Coimbatore architectural planning detail" 
          class="w-full h-full object-cover object-center"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent"></div>

        <div class="absolute bottom-6 sm:bottom-8 left-6 sm:left-8 right-6 sm:right-8 text-white">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#E6AF47] text-[#0e1013] text-[11px] sm:text-xs font-bold uppercase mb-2 sm:mb-3">
            Advisory Support
          </span>
          <h3 class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight mb-2">Have questions? We're here to help.</h3>
          <p class="text-xs sm:text-sm text-white/80 font-normal">
            Speak directly with our team in Coimbatore for verified project information.
          </p>

          <a 
            href={`https://wa.me/${siteConfig.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent("Hi Sanjay Properties, I have a few questions regarding Sanjay Garden.")}`} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 mt-4 sm:mt-5 px-5 py-2.5 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-xs font-semibold hover:bg-white hover:text-black transition-colors"
          >
            <span>Ask via WhatsApp</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: Accordion Items (10 Exact Questions) -->
    <div class="lg:col-span-7 gsap-fade-up">
      <div class="mb-6 sm:mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-black/5 text-[11px] sm:text-xs font-semibold tracking-widest uppercase text-[#121417] mb-2 sm:mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-[#E6AF47]"></span>
          FAQS
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-[#121417]">
          Frequently Asked Questions
        </h2>
        <p class="text-xs sm:text-sm text-[#5c626c] mt-1.5">
          Factual answers regarding Sanjay Garden and Sanjay Properties in Coimbatore.
        </p>
      </div>

      <div class="space-y-3 sm:space-y-3.5">
        {faqData.map((item, index) => (
          <details 
            class="group bg-white rounded-2xl border border-black/5 p-4 sm:p-5 transition-all duration-300 shadow-sm open:shadow-md [&_summary::-webkit-details-marker]:hidden"
            open={index === 0}
          >
            <summary class="flex items-center justify-between cursor-pointer font-bold text-xs sm:text-sm lg:text-base text-[#121417] list-none gap-3 sm:gap-4">
              <span>{item.question}</span>
              <div class="w-7 h-7 rounded-full bg-neutral-100 flex items-center justify-center group-open:bg-[#E6AF47] group-open:rotate-180 transition-transform duration-300 shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </div>
            </summary>
            <div class="mt-3 pt-3 border-t border-black/5 text-xs sm:text-sm text-[#5c626c] leading-relaxed">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>

  </div>

</section>
