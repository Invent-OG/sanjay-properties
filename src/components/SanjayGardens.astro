---
import { siteConfig } from '../data/sanjay-gardens';
---

<section id="sanjay-gardens" class="py-12 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 max-w-7xl mx-auto">
  
  <!-- Header Block -->
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-14 gap-5 gsap-fade-up">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#cbf33e]/30 text-[11px] sm:text-xs font-bold tracking-widest uppercase text-[#121417] mb-2 sm:mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-[#0e1013]"></span>
        FEATURED PROJECT
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-[#121417]">
        Sanjay Gardens
      </h2>
      <p class="text-base sm:text-lg md:text-xl text-[#5c626c] mt-1.5 font-normal">
        Thoughtfully planned living in Coimbatore.
      </p>
    </div>

    <div class="flex items-center gap-3">
      <a 
        href="#contact" 
        class="inline-flex items-center gap-2 px-5 sm:px-6 py-3 rounded-full bg-[#0e1013] text-white text-xs sm:text-sm font-semibold hover:bg-[#cbf33e] hover:text-[#0e1013] transition-all duration-300"
      >
        <span>Discover Sanjay Gardens</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Editorial Split Layout with Left Specs & Dramatic Right Imagery -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-10 items-stretch">
    
    <!-- Left Column: Project Attributes & Quick Filters -->
    <div class="lg:col-span-4 flex flex-col justify-between gap-6 gsap-fade-up">
      <!-- Attribute Specs Card -->
      <div class="rounded-[1.75rem] sm:rounded-[2rem] p-6 sm:p-8 bg-white border border-black/5 shadow-sm space-y-5">
        <h3 class="text-base sm:text-lg font-bold text-[#121417] pb-3 border-b border-black/5">Project Specifications</h3>

        <div class="space-y-3.5 text-xs sm:text-sm">
          <div class="flex justify-between items-center py-1.5 border-b border-black/5">
            <span class="text-[#5c626c]">Project</span>
            <span class="font-bold text-[#121417]">{siteConfig.projectName}</span>
          </div>
          <div class="flex justify-between items-center py-1.5 border-b border-black/5">
            <span class="text-[#5c626c]">Location</span>
            <span class="font-bold text-[#121417]">Coimbatore, TN</span>
          </div>
          <div class="flex justify-between items-center py-1.5 border-b border-black/5">
            <span class="text-[#5c626c]">Property Type</span>
            <span class="font-bold text-[#121417]">Residential Enclave</span>
          </div>
          <div class="flex justify-between items-center py-1.5 border-b border-black/5">
            <span class="text-[#5c626c]">Development Status</span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[11px] font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
              Active Development
            </span>
          </div>
          <div class="flex justify-between items-center py-1.5">
            <span class="text-[#5c626c]">Available Sizes</span>
            <span class="text-xs font-semibold text-[#121417]">On Enquiry</span>
          </div>
        </div>

        <a 
          href={`https://wa.me/${siteConfig.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent("Hi, I would like to receive the Sanjay Gardens project plan and brochure.")}`} 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full py-3.5 rounded-full bg-neutral-100 hover:bg-[#cbf33e] text-[#121417] font-semibold text-xs tracking-wider uppercase flex items-center justify-center gap-2 transition-colors text-center"
        >
          <span>Request Project Brochure</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
        </a>
      </div>

      <!-- Secondary Visual Card -->
      <div class="rounded-[1.75rem] sm:rounded-[2rem] overflow-hidden aspect-[4/3] relative bg-neutral-200 shadow-sm image-zoom-container">
        <img 
          src="/images/feature-sec.jpg" 
          alt="Sanjay Gardens Coimbatore outdoor living ambiance" 
          class="w-full h-full object-cover object-center"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
        <div class="absolute bottom-4 sm:bottom-5 left-4 sm:left-5 right-4 sm:right-5 text-white">
          <p class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-[#cbf33e]">Landscape & Living</p>
          <p class="text-xs sm:text-sm font-medium mt-0.5">Tranquil water features and open spaces</p>
        </div>
      </div>
    </div>

    <!-- Right Column: Dominant Hero Presentation with Play Badge -->
    <div class="lg:col-span-8 gsap-fade-up">
      <div class="relative rounded-[1.75rem] sm:rounded-[2.5rem] overflow-hidden shadow-xl aspect-[16/11] sm:aspect-[16/9] lg:h-full min-h-[340px] sm:min-h-[440px] bg-neutral-900 image-zoom-container flex flex-col justify-between p-5 sm:p-8 lg:p-10">
        <img 
          src="/images/feature-main.jpg" 
          alt="Sanjay Gardens Coimbatore luxury architectural pavilion villa" 
          class="absolute inset-0 w-full h-full object-cover object-center"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-black/10"></div>

        <!-- Center Floating Explore Badge -->
        <a 
          href="#gallery" 
          class="relative z-10 mx-auto my-auto w-14 h-14 sm:w-20 sm:h-20 rounded-full bg-white/20 backdrop-blur-md border border-white/40 flex items-center justify-center text-white hover:scale-110 hover:bg-[#cbf33e] hover:text-[#0e1013] transition-all duration-300 shadow-2xl"
          aria-label="View Project Gallery"
        >
          <svg class="w-5 h-5 sm:w-7 sm:h-7 translate-x-0.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
        </a>

        <!-- Bottom Overlay Information -->
        <div class="relative z-10 text-white flex flex-col sm:flex-row sm:items-end justify-between gap-4 mt-auto">
          <div class="max-w-md">
            <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-[#cbf33e]">Architectural Sanctuary</span>
            <h3 class="text-xl sm:text-2xl md:text-3xl font-bold mt-1">Crafting spaces where memories begin.</h3>
            <p class="text-xs sm:text-sm text-white/80 mt-1.5 font-normal">
              Designed around generous open vistas, natural air circulation, and privacy in Coimbatore.
            </p>
          </div>

          <a 
            href="#contact" 
            class="inline-flex items-center justify-center gap-2 px-4 sm:px-5 py-2.5 sm:py-3 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-white hover:bg-white hover:text-[#0e1013] text-xs font-semibold transition-all self-start sm:self-auto shrink-0"
          >
            <span>Enquire on Availability</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>
