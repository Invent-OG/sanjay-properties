---
import { siteConfig } from '../data/sanjayGarden';
---

<section id="sanjay-garden" class="py-12 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 max-w-7xl mx-auto">
  
  <!-- Header Block -->
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-14 gap-5 gsap-fade-up">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#cbf33e]/30 text-[11px] sm:text-xs font-bold tracking-widest uppercase text-[#121417] mb-2 sm:mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-[#0e1013]"></span>
        FEATURED PROJECT
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-[#121417]">
        Sanjay Garden
      </h2>
      <p class="text-base sm:text-lg md:text-xl text-[#5c626c] mt-1.5 font-normal">
        An established residential layout in Saravanampatti, Coimbatore.
      </p>
    </div>

    <div class="flex items-center gap-3">
      <a 
        href="#contact" 
        class="inline-flex items-center gap-2 px-5 sm:px-6 py-3 rounded-full bg-[#0e1013] text-white text-xs sm:text-sm font-semibold hover:bg-[#cbf33e] hover:text-[#0e1013] transition-all duration-300 shadow-sm"
      >
        <span>Enquire on Sanjay Garden</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Editorial Split Layout: Left Specifications & Right Dramatic Media -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-10 items-stretch">
    
    <!-- Left Column: Project Attributes & Historical Specifications -->
    <div class="lg:col-span-5 flex flex-col justify-between gap-6 gsap-fade-up">
      <!-- Specifications Card -->
      <div class="rounded-[1.75rem] sm:rounded-[2rem] p-6 sm:p-8 bg-white border border-black/5 shadow-sm space-y-5">
        <div class="flex items-center justify-between pb-3 border-b border-black/5">
          <h3 class="text-base sm:text-lg font-bold text-[#121417]">Project Record Data</h3>
          <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-black/5 text-[#5c626c]">Historical Records</span>
        </div>

        <div class="space-y-3 text-xs sm:text-sm">
          <div class="flex justify-between items-center py-1.5 border-b border-black/5">
            <span class="text-[#5c626c]">Project Name</span>
            <span class="font-bold text-[#121417]">{siteConfig.projectName}</span>
          </div>
          <div class="flex justify-between items-center py-1.5 border-b border-black/5">
            <span class="text-[#5c626c]">Historical Designation</span>
            <span class="font-semibold text-[#121417]">{siteConfig.historicalProjectDesignation}</span>
          </div>
          <div class="flex justify-between items-center py-1.5 border-b border-black/5">
            <span class="text-[#5c626c]">Location</span>
            <span class="font-bold text-[#121417]">Saravanampatti, Coimbatore</span>
          </div>
          <div class="flex justify-between items-center py-1.5 border-b border-black/5">
            <span class="text-[#5c626c]">Layout Reference</span>
            <span class="font-mono text-xs font-bold text-[#121417]">{siteConfig.layoutApprovalRef}</span>
          </div>
          <div class="flex justify-between items-center py-1.5 border-b border-black/5">
            <span class="text-[#5c626c]">Survey References</span>
            <span class="font-mono text-xs font-medium text-[#121417]">402/2pt, 402/3pt, 402/4pt</span>
          </div>
          <div class="flex justify-between items-center py-1.5 border-b border-black/5">
            <span class="text-[#5c626c]">Reserved Park Area</span>
            <span class="font-semibold text-[#121417]">{siteConfig.municipalOpenSpace}</span>
          </div>
          <div class="flex justify-between items-center py-1.5">
            <span class="text-[#5c626c]">Property Type</span>
            <span class="font-bold text-[#121417]">Residential House Sites</span>
          </div>
        </div>

        <p class="text-[11px] text-[#5c626c] italic leading-relaxed pt-2">
          * Historical layout reference — documentation to be confirmed with Sanjay Properties.
        </p>

        <a 
          href={`https://wa.me/${siteConfig.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent("Hi Sanjay Properties, I would like to receive the Sanjay Garden layout plan and details.")}`} 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full py-3.5 rounded-full bg-neutral-100 hover:bg-[#cbf33e] text-[#121417] font-semibold text-xs tracking-wider uppercase flex items-center justify-center gap-2 transition-colors text-center"
        >
          <span>Request Layout Plan</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
        </a>
      </div>

      <!-- Editorial Story Quote Box -->
      <div class="rounded-[1.75rem] sm:rounded-[2rem] p-6 bg-gradient-to-br from-neutral-100 to-white border border-black/5 shadow-sm">
        <span class="text-[11px] font-bold uppercase tracking-widest text-[#5c626c]">Sanjay Garden Story</span>
        <h4 class="text-lg font-bold text-[#121417] mt-1 mb-2">“Planned with space in mind.”</h4>
        <p class="text-xs sm:text-sm text-[#5c626c] leading-relaxed">
          The original Sanjay Garden Phase 1 layout shows a planned network of roads and residential house sites, with designated open space and commercial utility areas in Saravanampatti.
        </p>
      </div>
    </div>

    <!-- Right Column: Cinematic Visual Showcase -->
    <div class="lg:col-span-7 gsap-fade-up">
      <div class="relative rounded-[1.75rem] sm:rounded-[2.5rem] overflow-hidden shadow-xl aspect-[16/11] sm:aspect-[16/10] lg:h-full min-h-[380px] sm:min-h-[460px] bg-neutral-900 image-zoom-container flex flex-col justify-between p-6 sm:p-8 lg:p-10">
        <img 
          src="/images/feature-main.jpg" 
          alt="Sanjay Garden Saravanampatti residential planning and environment" 
          class="absolute inset-0 w-full h-full object-cover object-center"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/15"></div>

        <!-- Center Floating Action Badge -->
        <a 
          href="#layout" 
          class="relative z-10 mx-auto my-auto w-14 h-14 sm:w-20 sm:h-20 rounded-full bg-white/20 backdrop-blur-md border border-white/40 flex items-center justify-center text-white hover:scale-110 hover:bg-[#cbf33e] hover:text-[#0e1013] transition-all duration-300 shadow-2xl group"
          aria-label="Explore Layout Plan"
        >
          <svg class="w-5 h-5 sm:w-7 sm:h-7 transition-transform duration-300 group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
          </svg>
        </a>

        <!-- Bottom Overlay Details -->
        <div class="relative z-10 text-white flex flex-col sm:flex-row sm:items-end justify-between gap-4 mt-auto">
          <div class="max-w-md">
            <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-[#cbf33e]">Residential Planning</span>
            <h3 class="text-xl sm:text-2xl md:text-3xl font-bold mt-1">Thoughtful Layout in Saravanampatti.</h3>
            <p class="text-xs sm:text-sm text-white/80 mt-1.5 font-normal leading-relaxed">
              Designed around road networks, residential house sites, and designated open space in North-Eastern Coimbatore.
            </p>
          </div>

          <a 
            href="#contact" 
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-white hover:bg-[#cbf33e] hover:text-[#0e1013] text-xs font-semibold transition-all self-start sm:self-auto shrink-0 whitespace-nowrap"
          >
            <span>Enquire on Availability</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>
