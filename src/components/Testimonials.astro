---
import { siteConfig } from '../data/sanjayGarden';
---

<section class="py-12 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 max-w-5xl mx-auto text-center">
  
  <div class="gsap-fade-up">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-black/5 text-[11px] sm:text-xs font-semibold tracking-widest uppercase text-[#121417] mb-2 sm:mb-3">
      <span class="w-1.5 h-1.5 rounded-full bg-[#E6AF47]"></span>
      CUSTOMER PERSPECTIVES
    </div>
    
    <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-[#121417] mb-6 sm:mb-8">
      What our customers say.
    </h2>
  </div>

  <!-- Editorial Statement Container -->
  <div class="relative bg-white rounded-[1.75rem] sm:rounded-[2.5rem] p-6 sm:p-10 lg:p-14 border border-black/5 shadow-sm gsap-fade-up">
    <!-- Official Architectural Logo Emblem -->
    <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-[#0e1013] text-[#E6AF47] flex items-center justify-center p-3 mx-auto mb-6 shadow-lg">
      <svg class="w-full h-full" viewBox="0 0 160 120" fill="currentColor">
        <path d="M42 20 L86 28 L86 36 L44 28 Z" />
        <path d="M42 42 L86 50 L108 36 L126 42 L126 50 L108 44 L86 58 L42 50 Z" />
        <path d="M42 64 L86 72 L108 58 L126 64 L126 72 L108 66 L86 80 L42 72 Z" />
        <path d="M42 86 L86 94 L108 80 L126 86 L126 94 L108 88 L86 102 L42 94 Z" />
        <rect x="108" y="98" width="18" height="6" rx="1" />
      </svg>
    </div>

    <!-- Honest Placeholder Notice per requirements -->
    <div class="max-w-2xl mx-auto">
      <h3 class="text-xl sm:text-2xl font-bold text-[#121417] mb-3">
        Customer stories coming soon.
      </h3>
      <p class="text-xs sm:text-sm md:text-base text-[#5c626c] leading-relaxed mb-6">
        Sanjay Properties is dedicated to verified transparency. Client reviews and resident experiences from our Saravanampatti community will be published here following verified homeowner approval.
      </p>

      <div class="pt-4 border-t border-black/5">
        <p class="text-xs font-bold text-[#121417] uppercase tracking-wider">{siteConfig.brandName}</p>
        <p class="text-[11px] text-[#5c626c] mt-0.5">Sanjay Garden • Saravanampatti, Coimbatore</p>
      </div>
    </div>
  </div>

</section>
