---
import { siteConfig } from '../data/sanjay-gardens';
---

<section class="py-12 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 max-w-5xl mx-auto text-center">
  
  <div class="gsap-fade-up">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-black/5 text-[11px] sm:text-xs font-semibold tracking-widest uppercase text-[#121417] mb-2 sm:mb-3">
      <span class="w-1.5 h-1.5 rounded-full bg-[#cbf33e]"></span>
      CLIENT ADVISORY
    </div>
    
    <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-[#121417] mb-8 sm:mb-10">
      What Our Customers Say
    </h2>
  </div>

  <!-- Editorial Card Container -->
  <div class="relative bg-white rounded-[1.75rem] sm:rounded-[2.5rem] p-6 sm:p-10 lg:p-14 border border-black/5 shadow-sm gsap-fade-up">
    <!-- Avatar Group Stack -->
    <div class="flex items-center justify-center -space-x-3 mb-6 sm:mb-8">
      <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full border-2 border-white bg-neutral-800 text-white flex items-center justify-center font-bold text-xs shadow-md">
        SP
      </div>
      <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full border-2 border-white bg-[#cbf33e] text-[#0e1013] flex items-center justify-center font-bold text-xs sm:text-sm shadow-md">
        SG
      </div>
      <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full border-2 border-white bg-neutral-200 text-[#121417] flex items-center justify-center font-bold text-xs shadow-md">
        CB
      </div>
    </div>

    <!-- Editorial Client Statement -->
    <div class="max-w-2xl mx-auto">
      <p class="text-base sm:text-xl md:text-2xl font-medium text-[#121417] leading-relaxed italic mb-5 sm:mb-6">
        “Sanjay Properties provided absolute transparency from day one. Their focus on thoughtful planning and honest documentation sets a genuine benchmark in Coimbatore.”
      </p>

      <div>
        <p class="text-xs sm:text-sm font-bold text-[#121417] uppercase tracking-wider">Dedicated Homeowner Advisory</p>
        <p class="text-[11px] sm:text-xs text-[#5c626c] mt-0.5">Sanjay Gardens Community • Coimbatore</p>
      </div>
    </div>

    <!-- Navigation Controls -->
    <div class="flex items-center justify-between mt-8 sm:mt-10 pt-5 sm:pt-6 border-t border-black/5 text-xs text-[#5c626c]">
      <button 
        type="button" 
        class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-black/10 flex items-center justify-center hover:bg-neutral-100 hover:text-black transition-colors"
        aria-label="Previous Testimonial"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>

      <span class="font-mono text-xs">01 / 01</span>

      <button 
        type="button" 
        class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-black/10 flex items-center justify-center hover:bg-neutral-100 hover:text-black transition-colors"
        aria-label="Next Testimonial"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    </div>
  </div>

</section>
