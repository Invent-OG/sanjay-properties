---
import { siteConfig } from '../data/sanjayGarden';
---

<section id="hero" class="relative pt-2 sm:pt-4 px-2.5 sm:px-5 lg:px-8 pb-8 sm:pb-12">
  <!-- Outer Rounded Luxury Container -->
  <div 
    id="hero-container" 
    class="relative w-full min-h-[86vh] sm:min-h-[90vh] lg:min-h-[94vh] rounded-[1.75rem] sm:rounded-[2.5rem] lg:rounded-[3rem] overflow-hidden flex flex-col justify-between p-5 sm:p-10 lg:p-16 shadow-2xl bg-[#0e1013]"
  >
    <!-- Background Image with Soft Vignette -->
    <div class="absolute inset-0 z-0 image-zoom-container">
      <img 
        src="/images/hero.jpg" 
        alt="Sanjay Garden Saravanampatti Coimbatore architectural residential planning" 
        class="w-full h-full object-cover object-center transform scale-100"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#0e1013]/95 via-[#0e1013]/55 to-[#0e1013]/30"></div>
    </div>

    <!-- Top Spacer for Floating Navbar -->
    <div class="relative z-10 pt-14 sm:pt-20"></div>

    <!-- Main Content Area -->
    <div class="relative z-10 max-w-4xl text-white mt-auto pb-4 sm:pb-8">
      <!-- Eyebrow Pill -->
      <div class="hero-badge inline-flex items-center gap-2 px-3 sm:px-3.5 py-1.5 rounded-full bg-white/15 backdrop-blur-md border border-white/20 text-[11px] sm:text-xs font-semibold tracking-wider uppercase text-white/95 mb-3 sm:mb-6">
        <span class="w-2 h-2 rounded-full bg-[#cbf33e] animate-pulse shrink-0"></span>
        <span class="truncate">{siteConfig.brandName}</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.1] sm:leading-[1.08] mb-4 sm:mb-6 break-words">
        <span class="block hero-headline-line">A Better Address Begins</span>
        <span class="block hero-headline-line text-white/90">With Better Planning.</span>
      </h1>

      <!-- Supporting Text -->
      <p class="hero-subtext text-sm sm:text-lg md:text-xl text-white/80 max-w-2xl font-normal leading-relaxed mb-6 sm:mb-10">
        {siteConfig.heroSubheadline}
      </p>

      <!-- CTA Buttons Group -->
      <div class="hero-cta-group flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
        <a 
          href="#sanjay-garden" 
          class="inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3.5 sm:py-4 rounded-full bg-[#cbf33e] text-[#0e1013] font-bold text-sm sm:text-base hover:bg-[#bce628] hover:shadow-lg transition-all duration-300 group text-center"
        >
          <span>EXPLORE SANJAY GARDEN</span>
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>

        <div class="grid grid-cols-2 sm:flex sm:items-center gap-2.5 sm:gap-4">
          <a 
            href="#contact" 
            class="inline-flex items-center justify-center px-4 sm:px-7 py-3.5 sm:py-4 rounded-full bg-white/15 backdrop-blur-md border border-white/20 text-white font-semibold text-xs sm:text-base hover:bg-white/25 transition-all duration-300 text-center"
          >
            SCHEDULE A SITE VISIT
          </a>

          <a 
            href={`https://wa.me/${siteConfig.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(siteConfig.whatsappDefaultMsg)}`} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1.5 sm:gap-2 px-4 sm:px-5 py-3.5 sm:py-4 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-white/90 hover:text-[#cbf33e] hover:border-[#cbf33e]/50 font-medium text-xs sm:text-sm transition-all duration-300 text-center"
            aria-label="Chat with Sanjay Properties on WhatsApp"
          >
            <svg class="w-4 h-4 text-[#cbf33e] shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>WhatsApp</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Metadata & Location Indicator -->
    <div id="hero-scroll-indicator" class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between pt-3 sm:pt-4 border-t border-white/10 text-[11px] sm:text-xs text-white/60 gap-2">
      <div class="flex items-center gap-2 sm:gap-4 flex-wrap">
        <span>Featured Project: <strong class="text-white">{siteConfig.projectName}</strong></span>
        <span class="opacity-50">•</span>
        <span class="inline-flex items-center gap-1.5 font-semibold text-white/90">
          <span class="w-1.5 h-1.5 rounded-full bg-[#cbf33e]"></span>
          SARAVANAMPATTI · COIMBATORE
        </span>
      </div>

      <a href="#about" class="hidden sm:flex items-center gap-2 text-white/70 hover:text-white transition-colors self-end sm:self-auto" aria-label="Scroll to about section">
        <span>Scroll Down</span>
        <div class="w-5 h-5 rounded-full border border-white/30 flex items-center justify-center">
          <svg class="w-2.5 h-2.5 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
          </svg>
        </div>
      </a>
    </div>
  </div>
</section>
