---
import '../styles/global.css';
import { siteConfig, faqData } from '../data/sanjayGarden';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteConfig.brandName} | ${siteConfig.projectName}, Saravanampatti, Coimbatore`,
  description = "Discover Sanjay Garden by Sanjay Properties in Saravanampatti, Coimbatore. Explore the project, location, layout information and enquire about current availability.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://sanjayproperties.in');

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "RealEstateAgent",
      "@id": "https://sanjayproperties.in/#organization",
      "name": siteConfig.brandName,
      "url": "https://sanjayproperties.in",
      "description": siteConfig.brandTagline,
      "telephone": siteConfig.phone,
      "email": siteConfig.email,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": siteConfig.officeLocation,
        "addressLocality": siteConfig.locationCity,
        "addressRegion": siteConfig.locationState,
        "postalCode": siteConfig.locationPincode,
        "addressCountry": siteConfig.locationCountry
      }
    },
    {
      "@type": "Place",
      "@id": "https://sanjayproperties.in/#sanjay-garden",
      "name": `${siteConfig.projectName} (${siteConfig.historicalProjectDesignation})`,
      "description": "Established residential layout in Saravanampatti, Coimbatore, planned with road networks and open community space.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": siteConfig.historicalAddress,
        "addressLocality": siteConfig.locationCity,
        "addressRegion": siteConfig.locationState,
        "postalCode": siteConfig.locationPincode,
        "addressCountry": siteConfig.locationCountry
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://sanjayproperties.in/#website",
      "url": "https://sanjayproperties.in",
      "name": `${siteConfig.brandName} - ${siteConfig.projectName}`,
      "publisher": {
        "@id": "https://sanjayproperties.in/#organization"
      }
    },
    {
      "@type": "WebPage",
      "@id": "https://sanjayproperties.in/#webpage",
      "url": "https://sanjayproperties.in",
      "name": title,
      "description": description,
      "isPartOf": {
        "@id": "https://sanjayproperties.in/#website"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sanjayproperties.in"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": siteConfig.projectName,
          "item": "https://sanjayproperties.in/#sanjay-garden"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqData.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer
        }
      }))
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Sanjay Properties Coimbatore, Sanjay Garden Coimbatore, Sanjay Garden Saravanampatti, Sanjay Gardens Coimbatore, real estate Saravanampatti, properties Saravanampatti, plots Saravanampatti, residential plots Coimbatore, property in Saravanampatti, real estate in Coimbatore" />
    <meta name="author" content={siteConfig.brandName} />
    <meta name="geo.region" content="IN-TN" />
    <meta name="geo.placename" content="Saravanampatti, Coimbatore" />
    <meta name="geo.position" content="11.0805;76.9998" />
    <meta name="ICBM" content="11.0805, 76.9998" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/hero.jpg" />
    <meta property="og:site_name" content={siteConfig.brandName} />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/images/hero.jpg" />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-[#f6f6f3] text-[#121417] min-h-screen selection:bg-[#E6AF47] selection:text-[#0e1013]">
    <slot />

    <!-- GSAP Initialization Script -->
    <script>
      import { initLuxuryAnimations } from '../scripts/animations';

      function init() {
        initLuxuryAnimations();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }

      document.addEventListener('astro:page-load', init);
    </script>
  </body>
</html>
